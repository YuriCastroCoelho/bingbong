venv

# ==========================================
# Python / Django .gitignore
# ==========================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
bin/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Django specific
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
media/

# Virtual Environments (Highly recommended to exclude)
.venv/
venv/
ENV/
env/
ENV/
*.mo
*.pot

# Environment variables and secrets (NEVER commit these)
.env
.flaskenv
.secrets
*.secret

# JetBrains IDE (PyCharm, WebStorm, etc.)
.idea/

# VS Code
.vscode/
*.code-workspace

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
